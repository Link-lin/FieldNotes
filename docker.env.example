# Settings for `docker compose up -d`. Copy this file to .env (next to docker-compose.yml) and fill it in.
# .env holds secrets and is never committed.

# The address people open in a browser, with no trailing slash. Google sign-in needs https
# (http://localhost is the one exception, for trying it on the same machine).
APP_ORIGIN=https://notes.example.com

# Only for the https profile (`docker compose --profile https up -d`): the host name from APP_ORIGIN.
# It must point at this server, with ports 80 and 443 open.
APP_DOMAIN=notes.example.com

# A long random password for the database, made once: openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs sessions: openssl rand -base64 33
AUTH_SECRET=

# A Google OAuth client of type "Web application" (Google Cloud Console > APIs & Services > Credentials).
# Add this as an authorized redirect URI:  <APP_ORIGIN>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Your Google address(es), comma-separated: the accounts allowed to create trips. A Gmail address
# matches whatever its dots, +tag or googlemail.com spelling.
TRIP_OWNER_EMAILS=you@gmail.com

# Optional: a Google Maps Embed API key (event maps and Road route). Restrict it to the Maps Embed API
# and to APP_ORIGIN in Google Cloud.
GOOGLE_MAPS_EMBED_API_KEY=

# Optional: a Geoapify key for place suggestions in the AI import preview. It stays on the server.
GEOAPIFY_API_KEY=

# Optional: the port on this machine that the app listens on (localhost only). Default 3000.
APP_PORT=3000
