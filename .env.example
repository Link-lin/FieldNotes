# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL. `npm run db:start` runs a local server on port 5433 with these credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/travel_planner
# Optional: a schema-owner connection used only by `npm run db:migrate`.
# MIGRATION_DATABASE_URL=

# Canonical app origin; every state-changing request must come from here.
APP_ORIGIN=http://localhost:3000

# Auth.js builds its callback URLs from AUTH_URL; when unset it defaults to APP_ORIGIN.
# AUTH_URL=http://localhost:3000
# Auth.js. Generate a secret with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Google emails allowed to own trips (required in production). A Gmail address
# matches whatever its dots, +tag or googlemail.com spelling.
TRIP_OWNER_EMAILS=you@example.com

# Optional: sign in with Apple as well as Google (see "Signing in with Apple" in the README). All four are needed, from
# your Apple Developer account; Apple refuses http and localhost, so this needs a public https site. AUTH_APPLE_ID is
# the Services ID and AUTH_APPLE_PRIVATE_KEY the .p8 file's text (on one line, write its line breaks as \n).
AUTH_APPLE_ID=
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY=

# Optional: sign in with WeChat as well as Google. Both the ID and the secret are needed. The callback is
# <APP_ORIGIN>/api/auth/callback/wechat and your site's host name must be allowed for web authorization in the
# WeChat app (see "Signing in with WeChat" in the README). OfficialAccount (the default) signs people in inside
# WeChat's own browser and suits a WeChat test account; WebsiteApp shows a QR code on a desktop browser.
AUTH_WECHAT_ID=
AUTH_WECHAT_SECRET=
AUTH_WECHAT_PLATFORM=OfficialAccount

# Optional: send invitation emails from the Share dialog. Both are needed; without them the owner copies
# the invitation and sends it. SMTP_URL carries the mail password (smtps://user:password@host:465, or
# smtp://user:password@host:587 for STARTTLS), so keep it server-side and URL-encode special characters.
# MAIL_FROM is an address your mail service allows, for example: Field Notes <notes@example.com>
SMTP_URL=
MAIL_FROM=

# Optional: a Google Maps Embed API key for event panels and a day road-route view. Restrict it in
# Google Cloud to the Maps Embed API and to this site (for example http://localhost:3000/*).
# Without it the panel shows the event without a map.
GOOGLE_MAPS_EMBED_API_KEY=

# Optional: Geoapify forward-geocoding key for place suggestions (AI import, event editor) and automatic pins
# for a new event's place name when there is one clear match. Keep server-side.
# The Google Maps Embed key cannot return coordinates for the custom outline map.
GEOAPIFY_API_KEY=

# Optional: the AI connector (Claude and ChatGPT custom connectors) is on by default. Set to "off" to turn it off.
# Claude and ChatGPT can reach it only on a public https APP_ORIGIN.
# AI_CONNECTOR=off
