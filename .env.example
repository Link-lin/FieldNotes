# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL. `npm run db:start` runs a local server on port 5433 with these credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/travel_planner
# Optional: a schema-owner connection used only by `npm run db:migrate`.
# MIGRATION_DATABASE_URL=

# Canonical app origin; every state-changing request must come from here.
APP_ORIGIN=http://localhost:3000

# Auth.js builds its callback URLs from AUTH_URL; when unset it defaults to APP_ORIGIN.
# AUTH_URL=http://localhost:3000
# Auth.js. Generate a secret with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Google emails allowed to own trips (required in production). A Gmail address
# matches whatever its dots, +tag or googlemail.com spelling.
TRIP_OWNER_EMAILS=you@example.com

# Optional: a Google Maps Embed API key for event panels and a day road-route view. Restrict it in
# Google Cloud to the Maps Embed API and to this site (for example http://localhost:3000/*).
# Without it the panel shows the event without a map.
GOOGLE_MAPS_EMBED_API_KEY=

# Optional: Geoapify forward-geocoding key for AI-import place suggestions. Keep server-side.
# The Google Maps Embed key cannot return coordinates for the custom outline map.
GEOAPIFY_API_KEY=
