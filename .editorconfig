# Two-space indents, LF line endings and a final newline everywhere; `npm run format` (Prettier) does the rest for code.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# A trailing double space is a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
